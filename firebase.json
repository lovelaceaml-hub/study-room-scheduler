{
  "hosting": [
    {
      "target": "app",
      "public": "public",
      "redirects": [
        { "source": "/experiences/:path*", "destination": "/", "type": 301 }
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|css|json)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "legacy",
      "public": "legacy",
      "redirects": [
        { "source": "/", "destination": "https://lvrooms.web.app/", "type": 301 },
        { "source": "/:path*", "destination": "https://lvrooms.web.app/:path", "type": 301 }
      ]
    }
  ],
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "anonymous": true
    }
  }
}
