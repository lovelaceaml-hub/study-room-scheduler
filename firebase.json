{
  "hosting": [
    {
      "target": "app",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "firestore.indexes.json",
        "**/.*",
        "README.md",
        "docs/**",
        "design/**",
        "functions/**",
        "legacy/**",
        "test/**",
        "node_modules/**"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.css",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "legacy",
      "public": "legacy",
      "redirects": [
        {
          "source": "/",
          "destination": "https://lvrooms.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://lvrooms.web.app/:path",
          "type": 301
        }
      ]
    }
  ],
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "anonymous": true
    }
  }
}
