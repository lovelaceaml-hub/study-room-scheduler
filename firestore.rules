rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Server-enforced write kill switch (Rooms unification Section 8).
    // The switch SHIPS DISABLED: `app/writeFreeze` does not exist, so this
    // function returns false and behavior is unchanged. During the Section 9
    // cutover the Admin SDK writes `{ frozen: true }` and every client write —
    // including from stale cached apps — is refused. Clients cannot write
    // `app/*` documents, so nothing a browser does can unfreeze the schedule.
    function writesFrozen() {
      return exists(/databases/$(database)/documents/app/writeFreeze)
        && get(/databases/$(database)/documents/app/writeFreeze).data.frozen == true;
    }

    function validOwnerCancellation() {
      return signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status in ['pending', 'approved']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
    }

    // The schedule is intentionally public-by-link for members and lobby TV.
    // Sensitive notes are kept in privateBookingNotes instead of these docs.
    match /bookings/{bookingId} {
      allow read: if true;
      // Creation happens only through the memberSubmitBooking Cloud Function
      // (Admin SDK), which validates dates/slots/service blocks server-side
      // and enforces per-day and per-address limits. The old direct-create
      // path for schemaVersion 3 clients is retired.
      allow create: if false;
      allow update: if !writesFrozen() && validOwnerCancellation();
      allow delete: if false;
    }

    // Public app display configuration may be read, but only trusted backend
    // functions can change it. The Admin PIN is never stored here.
    match /app/settings {
      // The legacy settings document contains a fast-to-guess PIN hash and is
      // intentionally no longer exposed. The new Admin gate uses Secret Manager.
      allow read, write: if false;
    }
    match /app/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // These collections are server-only. Callable functions use the Admin SDK
    // and are not constrained by client rules.
    match /privateBookingNotes/{documentId} {
      allow read, write: if false;
    }
    match /adminSessions/{documentId} {
      allow read, write: if false;
    }
    match /adminRateLimits/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
