rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Study Rooms app — standalone project.
    // Reads stay open so members can see the schedule, but writes (booking requests)
    // now require an authenticated context (anonymous sign-in happens on load).
    // This blocks unauthorized script manipulation without adding any user login.
    match /bookings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /app/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
